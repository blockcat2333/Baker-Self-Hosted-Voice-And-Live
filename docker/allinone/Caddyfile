{
	auto_https disable_redirects
}

(baker_web) {
	encode zstd gzip

	route {
		handle /v1* {
			reverse_proxy 127.0.0.1:3001
		}

		handle /health {
			reverse_proxy 127.0.0.1:3001
		}

		handle /ws* {
			reverse_proxy 127.0.0.1:3002
		}

		handle /assets/* {
			root * /srv/web
			file_server
		}

		handle {
			root * /srv/web
			header Cache-Control "no-store, no-cache, must-revalidate"
			try_files {path} /index.html
			file_server
		}
	}
}

:80 {
	import baker_web
}

import /var/lib/baker/runtime/caddy/https.caddy

:8080 {
	encode zstd gzip

	route {
		handle /v1* {
			reverse_proxy 127.0.0.1:3001
		}

		handle /health {
			reverse_proxy 127.0.0.1:3001
		}

		handle /assets/* {
			root * /srv/admin
			file_server
		}

		handle {
			root * /srv/admin
			header Cache-Control "no-store, no-cache, must-revalidate"
			try_files {path} /index.html
			file_server
		}
	}
}
