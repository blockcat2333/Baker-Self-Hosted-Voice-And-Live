#include <windows.h>

IDI_BAKER_LITE ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/icons/baker-lite.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@BAKER_LITE_WINDOWS_VERSION_REVISION@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@BAKER_LITE_WINDOWS_VERSION_REVISION@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Baker\0"
            VALUE "FileDescription", "Baker Lite native voice client\0"
            VALUE "FileVersion", "@BAKER_LITE_VERSION@\0"
            VALUE "InternalName", "baker-lite\0"
            VALUE "LegalCopyright", "Copyright (C) Baker contributors\0"
            VALUE "OriginalFilename", "Baker Lite.exe\0"
            VALUE "ProductName", "Baker Lite\0"
            VALUE "ProductVersion", "@BAKER_LITE_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
