{
  "name": "@baker/desktop",
  "version": "1.0.7a",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:native:optional && vite build",
    "build:native:optional": "node scripts/build-excluded-system-audio.mjs",
    "build:native:win": "node scripts/build-excluded-system-audio.mjs --required",
    "dist:win": "pnpm build:native:win && vite build && electron-builder --win nsis --x64 --publish never",
    "dev": "vite",
    "lint": "eslint electron src vite.config.ts",
    "test": "vitest run src electron --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@baker/client": "workspace:*",
    "electron-updater": "^6.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "main": "dist/main/main.js",
  "build": {
    "appId": "com.blockcat2333.baker",
    "productName": "Baker",
    "artifactName": "${productName}-Setup-1.0.7a-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/baker-icon.png",
        "to": "branding/baker-icon.png"
      },
      {
        "from": "native/excluded-system-audio.exe",
        "to": "native/excluded-system-audio.exe"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "blockcat2333",
        "repo": "Baker-Self-Hosted-Voice-And-Live",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icons/baker.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
